# API Talleres runtime configuration example
# Copy this file to .env for local development and replace placeholder values.
# Never commit real secrets, production passwords, or host-specific credentials.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

DB_HOST=localhost
DB_USER=api_talleres_user
DB_PASSWORD=replace-with-local-password
DB_NAME=mapos

# Use a unique random value with at least 32 characters in production.
JWT_SECRET=replace-with-random-32-character-minimum-secret
JWT_EXPIRES_IN=1h
